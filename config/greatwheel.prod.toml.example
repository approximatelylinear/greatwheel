# Production config — hybrid deployment.
#
# Topology: this server + Postgres run on a small CPU VM behind Caddy.
# Chat and embeddings run on remote OpenAI-compatible endpoints (a hosted
# chat provider + your Modal embed deployment). No local Ollama/GPU.
#
# SECRETS:
#   - The LLM bearer token is NOT in this file. Set GW_LLM_API_KEY in the
#     environment (.env). The server reads it from the env var.
#   - The Postgres password IS in database.url below (the server reads the
#     connection string straight from this file — it does not interpolate
#     env vars). Keep the real, filled-in copy out of git:
#         cp greatwheel.prod.toml.example greatwheel.prod.toml   # then edit
#     `config/greatwheel.prod.toml` is gitignored.

[server]
host = "0.0.0.0"   # only reachable through Caddy on the private docker network
port = 8090

[database]
# `postgres` is the compose service name on the private network.
# This password must match POSTGRES_PASSWORD in your .env.
url = "postgres://gw:CHANGE_ME@postgres:5432/greatwheel"

[llm]
backend = "sglang"   # OpenAI-compatible shape: /v1/chat/completions + /v1/embeddings
# Chat endpoint — your hosted inference provider (OpenAI-compatible base URL).
proxy_url = "https://YOUR-CHAT-PROVIDER.example.com"
# Embeddings endpoint — your Modal deployment URL (printed by `modal deploy`).
ollama_url = "https://YOUR-WORKSPACE--gw-embed-embedder-web.modal.run"
default_model = "Qwen/Qwen3.5-9B"
embedding_model = "Qwen/Qwen3-Embedding-0.6B"
# NOTE: chat and embeddings share one bearer token (GW_LLM_API_KEY). If your
# chat provider and Modal need *different* keys, that needs a small follow-up
# (separate embed key) — see the handoff notes.

[agents]
directory = "agents"
hot_reload = false

[memory]
lance_db_path = "data/lancedb"
tantivy_index_path = "data/tantivy"
# Must match the dimension of `llm.embedding_model`. Qwen3-Embedding-0.6B is
# 1024-dim. Switching embedding models means re-indexing existing vectors.
embedding_dim = 1024

[kb]
# The KB plugin uses a SEPARATE embedder (gw_kb::embed::Embedder) that still
# targets Ollama via the ollama_url below — it is NOT covered by the sglang/
# Modal routing above. If the arxiv explorer relies on KB-side embeddings at
# runtime, this needs the same Modal treatment (follow-up). Otherwise set
# enabled = false for the initial launch.
enabled = false
lance_path = "data/kb-lancedb"
tantivy_path = "data/kb-tantivy"
embedding_model = "nomic-ai/nomic-embed-text-v1.5"
embedding_dim = 768
ollama_url = "http://localhost:11434"

[tracing]
exporter = "console"
postgres_export = false
service_name = "greatwheel"

[session]
idle_timeout_secs = 1800
