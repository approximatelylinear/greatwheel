# Production secrets/config for docker/docker-compose.prod.yml.
# Copy to `.env` (gitignored) on the VM and fill in real values.

# Domain with an A/AAAA record pointing at this VM. Caddy gets a TLS cert for it.
DOMAIN=arxiv.example.com

# Shared-password gate (Caddy basic_auth).
# Generate the hash:  docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# IMPORTANT: bcrypt hashes contain '$'. Escape each '$' as '$$' here so docker
# compose does not treat it as a variable.
BASIC_AUTH_USER=guest
BASIC_AUTH_HASH=$$2a$$14$$REPLACE_WITH_HASH

# Postgres password (internal network only — Postgres is not published).
# MUST match the password in config/greatwheel.prod.toml's database.url.
POSTGRES_PASSWORD=CHANGE_ME

# Bearer token sent to the LLM endpoints. Must match GW_EMBED_TOKEN in your
# Modal secret (and your chat provider's key, if it uses the same token).
GW_LLM_API_KEY=CHANGE_ME
